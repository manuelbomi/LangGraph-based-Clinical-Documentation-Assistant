# Copy this file to `.env` (repo root, and/or `backend/.env`) and fill in
# real values. NEVER commit your actual `.env` file (it's git-ignored).

# --- LLM provider ------------------------------------------------------
# "openai" (default, tested) or "anthropic"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0

# --- Postgres (prompts, patients/encounters history, LangGraph checkpoints) -
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clinical_docs
# Local dev (no Docker): localhost. Inside docker-compose: host "postgres".
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clinical_docs

# --- Documents -------------------------------------------------------------
# Where uploaded notes are stored (git-ignored).
UPLOAD_DIR=./data/uploads
# Where the bundled synthetic sample notes / ICD-10 reference data live.
# Local dev: one level up from backend/. Docker: mounted read-only at
# /app/sample-data.
SAMPLE_DATA_DIR=../sample-data

# --- Milvus Lite (embedded ICD-10 semantic lookup, no server/docker needed) -
MILVUS_LITE_PATH=./data/milvus_icd10.db
MILVUS_COLLECTION=icd10_codes
ICD10_TOP_K=3

# --- API / CORS ----------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
